{
  "name": "reddoc-360",
  "private": true,
  "version": "0.1.0",
  "description": "Gestión documental de una red de IPS aliadas: portal de cargue, auditoría, tableros de cumplimiento y control de acceso por rol y regional sobre Supabase.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:generar": "node scripts/generar-seed.mjs",
    "usuarios:demo": "node --env-file=.env scripts/crear-usuarios-demo.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
