# Copie este archivo como .env y complete con los datos de su proyecto Supabase
# (Project Settings → API). El archivo .env está en .gitignore.

# Públicas: las usa el navegador. La anon key es segura de exponer porque
# todo acceso a datos pasa por las políticas RLS de la base.
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Secreta: SÓLO para scripts locales (npm run usuarios:demo). Nunca en el frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Contraseña común de los usuarios de demostración.
DEMO_PASSWORD=RedDoc360-demo
